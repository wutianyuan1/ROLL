==== Local vLLM package initialized ====
model_size: 72B
exp_name: qwen2.5-72B-rlvr-config
seed: 42
logging_dir: ./output/logs
output_dir: ./output
system_envs:
  USE_MODELSCOPE: '1'
checkpoint_config:
  type: file_system
  output_dir: ./models/qwen2.5-72B-rlvr-config
max_steps: 300
save_steps: 100
logging_steps: 1
eval_steps: 10
resume_from_checkpoint: false
global_template: longCOT_qwen2.5
rollout_batch_size: 32
prompt_length: 2048
response_length: 8192
num_return_sequences_in_group: 8
ppo_epochs: 1
adv_estimator: reinforce
value_clip: 0.5
reward_clip: 10
advantage_clip: 2.0
dual_clip_loss: true
reward_norm: null
reward_shift: false
reward_scale: false
max_len_mask: true
difficulty_mask: true
difficulty_low_threshold: 0.1
difficulty_high_threshold: 0.95
error_max_len_clip: false
difficulty_loss_weight: false
length_loss_weight: false
add_token_level_kl: false
whiten_advantages: true
enable_migration: false
pretrain: Qwen/Qwen2.5-72B
reward_pretrain: Qwen/Qwen2.5-72B
validation:
  data_args:
    template: longCOT_qwen2.5
    file_name:
    - data/aime24_25_deal.jsonl
  generating_args:
    top_p: 0.6
    top_k: 50
    num_beams: 1
    temperature: 0.6
    num_return_sequences: 1
  eval_steps: 10
actor_train:
  model_args:
    flash_attn: fa2
    disable_gradient_checkpointing: false
    dtype: bf16
    model_type: null
  training_args:
    learning_rate: 1.0e-06
    weight_decay: 0
    per_device_train_batch_size: 1
    gradient_accumulation_steps: 32
    warmup_steps: 20
    num_train_epochs: 50
  data_args:
    template: longCOT_qwen2.5
    file_name:
    - data/math_deepmath_deal.jsonl
    domain_interleave_probs:
      math_rule: 1.0
    dataset_dir: data
    messages: messages
    interleave_probs: '1.0'
    preprocessing_num_workers: 16
  strategy_args:
    strategy_name: megatron_train
    strategy_config:
      tensor_model_parallel_size: 8
      pipeline_model_parallel_size: 4
      expert_model_parallel_size: 1
      use_distributed_optimizer: true
  device_mapping: list(range(0,32))
  device_affinity: NVIDIA H800
  num_gpus_per_node: 8
  infer_batch_size: 1
  use_remove_padding: true
actor_infer:
  model_args:
    flash_attn: fa2
    disable_gradient_checkpointing: true
    dtype: bf16
  generating_args:
    max_new_tokens: 8192
    top_p: 0.99
    top_k: 100
    num_beams: 1
    temperature: 0.99
    num_return_sequences: 8
  data_args:
    template: longCOT_qwen2.5
  strategy_args:
    strategy_name: vllm
    strategy_config:
      gpu_memory_utilization: 0.7
      block_size: 16
      load_format: auto
      tensor_parallel_size: 4
  device_affinity: NVIDIA H800
  num_gpus_per_node: 8
  device_mapping: list(range(0,32))
  infer_batch_size: 1
reference:
  model_args:
    flash_attn: fa2
    disable_gradient_checkpointing: true
    dtype: bf16
    model_type: null
  data_args:
    template: longCOT_qwen2.5
  strategy_args:
    strategy_name: megatron_infer
    strategy_config:
      tensor_model_parallel_size: 8
      pipeline_model_parallel_size: 1
      expert_model_parallel_size: 1
  device_affinity: NVIDIA H800
  num_gpus_per_node: 8
  device_mapping: list(range(0,32))
  infer_batch_size: 8
rewards:
  math_rule:
    worker_cls: roll.pipeline.rlvr.rewards.math_rule_reward_worker.MathRuleRewardWorker
    model_args:
      model_name_or_path: Qwen/Qwen2.5-72B
    data_args:
      template: longCOT_qwen2.5
    tag_included:
    - deepmath_103k
    - aime
    world_size: 4
    infer_batch_size: 1

