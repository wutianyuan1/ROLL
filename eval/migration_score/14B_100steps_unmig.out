[36m(MathRuleRewardWorker(reward-math_rule-2) pid=603745)[0m n-1 \leq \frac{100}{6}
[36m(MathRuleRewardWorker(reward-math_rule-2) pid=603745)[0m \]
[36m(MathRuleRewardWorker(reward-math_rule-2) pid=603745)[0m 
[36m(MathRuleRewardWorker(reward-math_rule-2) pid=603745)[0m \[
[36m(MathRuleRewardWorker(reward-math_rule-2) pid=603745)[0m n-1 \leq 16.67
